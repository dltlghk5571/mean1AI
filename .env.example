APP_ENV=development
DATABASE_URL=sqlite:///./civic_ai.db
AI_PROVIDER=rules
# Club classification requires AI_PROVIDER=club and AI_DEFERRED_ENABLED=true.
CLASSIFIER_ENDPOINT_URL=
CLASSIFIER_MODEL_ID=
CLASSIFIER_API_KEY=
CLASSIFIER_RESPONSE_MODE=model
CLASSIFIER_REQUEST_TIMEOUT_SECONDS=10
CLASSIFIER_MAX_CONCURRENT=2
CHAT_PROVIDER=agent_demo
# off: existing manual flow; demo: one explicit synthetic example; club: agent model extraction.
CHAT_EXTRACTION_PROVIDER=off
CHAT_EXTRACTION_ENDPOINT_URL=
CHAT_ENDPOINT_URL=
CHAT_MODEL_ID=
CHAT_API_KEY=
CHAT_REQUEST_TIMEOUT_SECONDS=15
CHAT_TURN_TIMEOUT_SECONDS=30
CHAT_MAX_CONCURRENT=4
INCIDENT_COMPARE_PROVIDER=off
INCIDENT_COMPARE_ENDPOINT_URL=
INCIDENT_COMPARE_MODEL_ID=
INCIDENT_COMPARE_API_KEY=
INCIDENT_COMPARE_TIMEOUT_SECONDS=10
INCIDENT_COMPARE_MAX_CONCURRENT=2
AI_DEFERRED_ENABLED=false
AI_QUEUE_MAX_ATTEMPTS=3
AI_QUEUE_RETRY_SECONDS=30
AI_QUEUE_LEASE_SECONDS=120
SESSION_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
AUTO_ROUTE_THRESHOLD=0.90
LOG_LEVEL=INFO

# The optional model gateway does NOT read this .env or start with the web app.
# Set MODEL_GATEWAY_* in its separate process environment; see docs/MODEL_GATEWAY.md.
# Default: MODEL_GATEWAY_MODE=disabled. Synthetic testing requires an explicit key.
# MODEL_GATEWAY_MODE=synthetic
# MODEL_GATEWAY_API_KEY=replace-outside-git
# MODEL_GATEWAY_AGENT_MODEL_ID=synthetic-agent-v1
# MODEL_GATEWAY_CLASSIFIER_MODEL_ID=synthetic-classifier-v1
# MODEL_GATEWAY_REQUEST_TIMEOUT_SECONDS=10
# MODEL_GATEWAY_MAX_CONCURRENT=2
